# Copy this file to .env in the backend directory and fill in the values.
# backend/.env is ignored by git. Never commit real values.
# Everything in this file is server side only. Never copy these into the frontend.

# Required: Supabase project URL, the same one the frontend uses.
# Example: https://your-project-id.supabase.co
# The backend verifies logins with this project's public signing keys (JWKS),
# so no Supabase key is needed here.
SUPABASE_URL=

# Required: Supabase Postgres connection string, using the psycopg driver.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
DATABASE_URL=

# Optional, private. Leave blank. If set, the backend verifies logins with this
# shared secret (HS256) instead of the public signing keys above.
# Tests set their own fake secret, so nothing here is needed to run them.
SUPABASE_JWT_SECRET=

# Ingestion API keys (S1-020) go in this file when they are added.
# They must never use a VITE_ prefix, because VITE_ values ship to the browser.
