# Same project URL used by the frontend. No publishable key is needed for JWKS.
SUPABASE_URL=
# Optional: only for projects using legacy HS256 signing. Never use the API key.
SUPABASE_JWT_SECRET=
# Optional locally (defaults to backend/instance/reviewlens.db).
# For Supabase Postgres use postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
DATABASE_URL=
