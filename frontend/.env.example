# Copy this file to .env.local in the frontend directory and fill in the values.

# Supabase project URL. Get it from the team's Supabase project dashboard.
# Example: https://your-project-id.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key from the same project (starts with sb_publishable_).
VITE_SUPABASE_PUBLISHABLE_KEY=
